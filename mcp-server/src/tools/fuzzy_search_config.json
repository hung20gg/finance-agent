{
    "search_backend": "rapidfuzz",
    "searchable_entities": {
        "category_code": {
            "table_name": "dim_financial_statement_category",
            "search_columns": ["category_name", "category_code"],
            "return_columns": ["category_code", "category_name"],
            "description": "Search for financial statement category codes (e.g. revenue IS_001, net profit IS_100, total assets BS_001, liabilities BS_300, cash flow CF_*)",
            "threshold": 50,
            "limit": 10,
            "distinct": false
        },
        "ratio_code": {
            "table_name": "dim_financial_ratio",
            "search_columns": ["ratio_name", "ratio_code", "function_name"],
            "return_columns": ["ratio_code", "ratio_name", "function_name"],
            "description": "Search for financial ratio codes (e.g. ROA, ROE, EPS, P/E, FCF, debt-to-equity) and their computation formulas",
            "threshold": 50,
            "limit": 10,
            "distinct": false
        },
        "stock_code": {
            "table_name": "dim_company",
            "search_columns": ["stock_code", "company_name", "short_name"],
            "return_columns": ["stock_code", "company_name", "short_name"],
            "description": "Search for stock ticker codes by company name, short name, or ticker symbol",
            "threshold": 50,
            "limit": 10,
            "distinct": false
        },
        "index_name": {
            "table_name": "dim_market_index",
            "search_columns": ["index_name"],
            "return_columns": ["index_id", "index_name"],
            "description": "Search for market index names (e.g. VNINDEX, VN30, HNX, HNXINDEX, UPCOM)",
            "threshold": 50,
            "limit": 10,
            "distinct": false
        },
        "indicator_code": {
            "table_name": "dim_commodity_indicator",
            "search_columns": ["indicator_name", "indicator_code"],
            "return_columns": ["indicator_code", "indicator_name", "unit"],
            "description": "Search for commodity indicator names and codes (e.g. Crude Oil WTI, Gold, Silver, Copper, Natural Gas)",
            "threshold": 50,
            "limit": 10,
            "distinct": false
        },
        "macro_indicator": {
            "table_name": "dim_macro_indicator",
            "search_columns": ["indicator_name"],
            "return_columns": ["indicator_id", "indicator_name", "unit"],
            "description": "Search for macroeconomic indicator names (e.g. CPI, GDP, interest rate, exchange rate, PMI, unemployment)",
            "threshold": 50,
            "limit": 10,
            "distinct": false
        },
        "industry": {
            "table_name": "dim_industry",
            "search_columns": ["industry_name"],
            "return_columns": ["industry_id", "industry_name"],
            "description": "Search for industry/sector classifications (e.g. Banking, Real Estate, Oil and Gas, Financial Services, Technology)",
            "threshold": 50,
            "limit": 10,
            "distinct": false
        },
        "exchange": {
            "table_name": "dim_exchange",
            "search_columns": ["exchange_name"],
            "return_columns": ["exchange_id", "exchange_name"],
            "description": "Search for stock exchange names (e.g. HOSE, HNX, UPCOM)",
            "threshold": 50,
            "limit": 10,
            "distinct": false
        },
        "country": {
            "table_name": "dim_country",
            "search_columns": ["country_name"],
            "return_columns": ["country_id", "country_name"],
            "description": "Search for country names for macroeconomic data filtering (e.g. Vietnam, United States, China, Japan)",
            "threshold": 50,
            "limit": 10,
            "distinct": false
        }
    }
